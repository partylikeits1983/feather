{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "jsxImportSource": "preact", "strict": true, "skipLibCheck": true,
    "esModuleInterop": true, "allowImportingTsExtensions": true,
    "resolveJsonModule": true, "isolatedModules": true, "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["frontend", "vite.config.ts", "tests", "benchmarks", "playwright.config.ts"]
}
